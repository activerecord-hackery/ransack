source 'https://rubygems.org'

gem 'jekyll', '~> 4.4'
# Pinned to the minor release, as the theme's layouts are the site's layouts.
gem 'jekyll-vitepress-theme', '~> 1.9.1'
gem 'jekyll-relative-links'
gem 'jekyll-redirect-from'
# `jekyll serve` needs WEBrick, which Ruby 3.0+ no longer bundles.
gem 'webrick'

group :test do
  gem 'html-proofer'
end
